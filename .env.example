# --- Payload ---------------------------------------------------------------
# Chaîne aléatoire longue : sert à signer les jetons d'authentification.
PAYLOAD_SECRET=

# --- Base Postgres ---------------------------------------------------------
# Neon, Supabase, ou n'importe quel Postgres accessible.
# Tant que cette variable est vide, le site sert le contenu de démonstration.
DATABASE_URI=

# --- Cloudflare R2 (compatible S3) -----------------------------------------
# Sans ces variables, les médias sont écrits sur le disque local.
R2_BUCKET=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Domaine public du bucket, utilisé par next/image.
R2_PUBLIC_URL=
