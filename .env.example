# --- Payload ---------------------------------------------------------------
# Chaîne aléatoire longue : sert à signer les jetons d'authentification.
PAYLOAD_SECRET=

# --- Base Postgres ---------------------------------------------------------
# Injectée automatiquement par l'intégration Neon du Marketplace Vercel.
# DATABASE_URI est également accepté pour une base fournie à la main.
# Tant qu'aucune des deux n'est renseignée, le site sert le contenu de démo.
DATABASE_URL=

# --- Vercel Blob (médias) --------------------------------------------------
# Injecté automatiquement par le store Blob du projet Vercel.
# Sans ce jeton, les fichiers sont écrits sur le disque local (dev uniquement).
BLOB_READ_WRITE_TOKEN=
