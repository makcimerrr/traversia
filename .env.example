# --- Payload ---------------------------------------------------------------
# Chaîne aléatoire longue : sert à signer les jetons d'authentification.
PAYLOAD_SECRET=

# --- Base Postgres ---------------------------------------------------------
# Injectée automatiquement par l'intégration Neon du Marketplace Vercel.
# DATABASE_URI est également accepté pour une base fournie à la main.
# Tant qu'aucune des deux n'est renseignée, le site sert le contenu de démo.
DATABASE_URL=

# --- Vercel Blob (médias) --------------------------------------------------
# Injecté automatiquement par le store Blob du projet Vercel.
# Sans ce jeton, les fichiers sont écrits sur le disque local (dev uniquement).
BLOB_READ_WRITE_TOKEN=

# --- Paiement (Stripe) ------------------------------------------------------
# Injectées par l'intégration Stripe du Marketplace Vercel. Sans clé secrète,
# le tunnel enregistre des « demandes » à confirmer à la main.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Secret de signature du webhook, créé dans le tableau de bord Stripe pour
# l'URL https://<domaine>/api/stripe/webhook (événements
# checkout.session.completed, checkout.session.expired, charge.refunded).
STRIPE_WEBHOOK_SECRET=

# --- E-mails (Resend) -------------------------------------------------------
# Injectée par l'intégration Resend du Marketplace Vercel. Sans clé, les
# messages sont journalisés dans la console.
RESEND_API_KEY=
# Expéditeur, sur un domaine vérifié chez Resend.
EMAIL_FROM="Traversia <reservations@traversia.fr>"

# --- URL publique -----------------------------------------------------------
# Pour les liens absolus (Stripe, e-mails). Déduite de Vercel si absente.
NEXT_PUBLIC_SITE_URL=
